{{!
    @template core/local/login_form/authinstructions

    Context variables required for this template:
    * hasauthinstructions - Flag, set to true when auth_signupinstructions is configured,
    * authinstructions - signupinstructions.


    Example context (json):
    {
        "hasauthinstructions": true,
        "authinstructions": "For full access to this site, you first need to create an account."
    }
}}
{{#hasauthinstructions}}
    <div class="d-lg-none small mb-3">
        {{{authinstructions}}}
    </div>
{{/hasauthinstructions}}
