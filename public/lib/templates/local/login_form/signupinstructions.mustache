{{!
    @template core/local/login_form/signupinstructions

    Context variables required for this template:
    * hasauthsignupinstructions - Flag, set to true when auth_signupinstructions is configured,
    * signupinstructions - signupinstructions,
    * signupinstructionsformat - Format of signupinstructions,
    * cansignup - Signup allowed?,
    * signupurl - URL for signup page,


    Example context (json):
    {
        "cansignup": true,
        "identityproviders": [],
        "signupinstructions": "For full access to this site, you first need to create an account.",
        "signupinstructionsformat": "1"
    }
}}
{{#cansignup}}
    <div class="text-center small mb-3">
        {{#signupinstructions}}
            <span class="text-muted me-1">{{{signupinstructions}}}</span>
        {{/signupinstructions}}
        <a href="{{signupurl}}">{{#str}}loginstartsignup{{/str}}</a>
    </div>
{{/cansignup}}
{{^cansignup}}
    {{#signupinstructions}}
        <p class="small mb-3">{{{signupinstructions}}}</p>
    {{/signupinstructions}}
{{/cansignup}}
