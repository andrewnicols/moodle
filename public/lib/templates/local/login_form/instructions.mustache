{{!
    @template core/local/login_form/instructions

    Context variables required for this template:
    * hasauthinstructions - Flag, set to true when auth_instructions is configured,
    * instructions - Instructions,
    * instructionsformat - Format of instructions,
    * cansignup - Signup allowed?,
    * signupurl - URL for signup page,


    Example context (json):
    {
        "cansignup": true,
        "hasauthinstructions": false,
        "identityproviders": [],
        "instructions": "For full access to this site, you first need to create an account.",
        "instructionsformat": "1"
    }
}}
{{#hasauthinstructions}}
    <div class="d-lg-none small mb-3">
        {{{instructions}}}
    </div>
{{/hasauthinstructions}}
{{^hasauthinstructions}}
    {{#cansignup}}
        <div class="text-center small mb-3">
            {{#instructions}}
                <span class="text-muted me-1">{{{instructions}}}</span>
            {{/instructions}}
            <a href="{{signupurl}}">{{#str}}loginstartsignup{{/str}}</a>
        </div>
    {{/cansignup}}
    {{^cansignup}}
        {{#instructions}}
            <p class="small mb-3">{{{instructions}}}</p>
        {{/instructions}}
    {{/cansignup}}
{{/hasauthinstructions}}
{{#hasauthinstructions}}
    {{#cansignup}}
        <div class="text-center small mb-3">
            <a href="{{signupurl}}">{{#str}}loginstartsignup{{/str}}</a>
        </div>
    {{/cansignup}}
{{/hasauthinstructions}}
